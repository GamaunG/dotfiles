# aibox — OCR (PaddleOCR) + translation (NLLB), CPU-only, models kept warm.
#
# Build:  podman build -t aibox:cpu .
# Model download and service lifecycle are driven by ./aibox.sh.
FROM docker.io/library/python:3.11-slim

# System libs needed by paddle/opencv at runtime. --no-install-recommends keeps
# the image lean (no docs, no extra suggested packages).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch + transformers + paddle. Versions pinned.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir transformers sentencepiece langdetect \
        paddlepaddle==3.0.0 paddleocr==3.6.0 \
        "numpy<2" opencv-python-headless pillow

# /usr/local/bin/aibox is a symlink to python3. Running the service as
# `aibox /app/worker.py` makes the daemon show up as "aibox" (not python3) in
# `ps`, `top` and `podman ps` — the kernel derives /proc/PID/comm from the
# invoked binary name, and the command line carries argv[0] = "aibox".
RUN ln -s python3 /usr/local/bin/aibox

# Model caches live on the named volume aibox_models (see aibox.sh). They are
# downloaded once by the fetch step and reused across rebuilds, so editing the
# code never re-downloads the ~11 GB of models.
ENV HF_HOME=/models/hf \
    PADDLE_PDX_CACHE_HOME=/models/paddlex \
    OMP_NUM_THREADS=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY app/cli.py app/worker.py app/download.py /app/

# CMD (not ENTRYPOINT): a command given to `podman run` fully REPLACES it, so
# the fetch step can run download.py without argument duplication.
CMD ["aibox", "/app/worker.py"]
